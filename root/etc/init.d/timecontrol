#!/bin/sh /etc/rc.common

# 时间访问控制服务（黑名单：列表中的时段禁止上网）

START=95
STOP=10

USE_PROCD=0

CHAIN_NAME="raw_prerouting"
INCLUDE_DIR="/usr/share/nftables.d/chain-post/$CHAIN_NAME"
INCLUDE_FILE="$INCLUDE_DIR/90-timecontrol.nft"

convert_weekday() {
    case "$1" in
        Mon) echo "Monday" ;;
        Tue) echo "Tuesday" ;;
        Wed) echo "Wednesday" ;;
        Thu) echo "Thursday" ;;
        Fri) echo "Friday" ;;
        Sat) echo "Saturday" ;;
        Sun) echo "Sunday" ;;
        *) echo "$1" ;;
    esac
}

# 把一条 timeslot 转换成 fw4 include 片段
append_timeslot_rules() {
    local timeslot="$1"
    local slot_device slot_enable device_enable mac_addr
    local weekdays start_time stop_time day full_day

    config_get slot_device "$timeslot" device
    [ -n "$slot_device" ] || return

    config_get device_enable "$slot_device" enable "1"
    [ "$device_enable" = "1" ] || return

    # 单条规则可独立禁用（未设置时默认启用，兼容旧配置）
    config_get slot_enable "$timeslot" enable "1"
    [ "$slot_enable" = "1" ] || return

    config_get mac_addr "$slot_device" mac
    [ -n "$mac_addr" ] || return

    config_get weekdays "$timeslot" weekdays
    config_get start_time "$timeslot" start_time
    config_get stop_time "$timeslot" stop_time
    [ -n "$weekdays" ] && [ -n "$start_time" ] && [ -n "$stop_time" ] || return

    for day in $weekdays; do
        full_day=$(convert_weekday "$day")
        [ -n "$full_day" ] || continue
        printf '\tether saddr %s meta day "%s" meta hour "%s"-"%s" drop comment "timecontrol-%s-%s"\n' \
            "$mac_addr" "$full_day" "$start_time" "$stop_time" "$slot_device" "$day" >> "$INCLUDE_FILE"
    done
}

generate_include_file() {
    mkdir -p "$INCLUDE_DIR"
    : > "$INCLUDE_FILE"

    config_load timecontrol
    config_foreach append_timeslot_rules timeslot
}

reload_firewall() {
    if command -v fw4 >/dev/null 2>&1; then
        fw4 check >/dev/null 2>&1 || {
            echo "timecontrol: invalid nft include, firewall not reloaded" >&2
            return 1
        }
        fw4 reload >/dev/null 2>&1
    else
        /etc/init.d/firewall reload >/dev/null 2>&1
    fi
}

reload_rules() {
    generate_include_file
    reload_firewall
}

start_service() {
    reload_rules
    echo "timecontrol service started"
}

stop_service() {
    rm -f "$INCLUDE_FILE"
    reload_firewall
    echo "timecontrol service stopped"
}

reload_service() {
    reload_rules
    echo "timecontrol rules reloaded"
}

# USE_PROCD=0 时 rc.common 不会自动映射这些函数，必须显式定义
start() {
    start_service
}

stop() {
    stop_service
}

reload() {
    reload_service
}
